# Copy this file to .env and fill in your own DeepSeek credentials.
DEEPSEEK_API_KEY=
BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat
# Optional web search provider for broader region/industry/peer discovery.
# Without a key, official-source indexes and best-effort public RSS remain available.
TAVILY_API_KEY=
# Optional: admin password for the platform-model management page (/admin.html).
# Leave empty to disable the admin console. Example: ADMIN_PASSWORD=change-me
ADMIN_PASSWORD=
# Optional: master key (Fernet) encrypting API keys stored in SQLite.
# Leave empty to auto-generate one persisted in the database app_meta table.
FINBRIDGE_ENC_KEY=
