# 复制为同目录下的 .env 并填入自己的密钥；.env 已被 .dockerignore 与 .gitignore 排除，
# 不会被打包进镜像，也不会上传 GitHub。
DEEPSEEK_API_KEY=
BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat

# 可选：联网检索服务密钥；不配置时仅官方来源索引与公开 RSS 可用，不影响本地计算。
TAVILY_API_KEY=

# 可选：管理后台（/admin.html）的登录密码；留空表示关闭管理后台。
# 设置后首次启动自动播种 admin 账户（仅播种时生效），后台可维护平台托管模型与全部用户账户。
# ADMIN_PASSWORD=change-me

# 可选：API Key 加密主密钥（Fernet 格式）；留空时首次启动自动生成并存入数据库 app_meta 表。
# FINBRIDGE_ENC_KEY=

# 数据库路径：镜像内已默认指向持久化卷 /app/storage/runtime.sqlite3，通常无需修改。
# FINBRIDGE_DB_PATH=/app/storage/runtime.sqlite3
